{
  "apiVersion": "wish.plugin/v1",
  "id": "example.greeting-provider",
  "displayName": "Greeting Provider",
  "entry": "./provider.mjs",
  "managementClass": "managed",
  "replacement": "drain",
  "configSchema": {
    "type": "object",
    "properties": {
      "prefix": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "additionalProperties": false
  },
  "permissions": {
    "capabilities": []
  },
  "sandbox": {
    "isolation": "trusted-in-process",
    "filesystem": "none",
    "process": "none",
    "network": "none"
  },
  "state": {
    "mode": "stateless"
  }
}
